# Public values only. Never put a private key in NEXT_PUBLIC_* -- it is shipped to the browser.
#
# Deployed EmergencyHalt contract on GenLayer Studionet (chain 61999).
NEXT_PUBLIC_GENLAYER_RPC=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61999
NEXT_PUBLIC_HALT_ADDRESS=0x0000000000000000000000000000000000000000

# Target EVM chain the contract reads evidence from. Base Sepolia public RPC needs no key.
NEXT_PUBLIC_TARGET_CHAIN_RPC=https://base-sepolia-rpc.publicnode.com
NEXT_PUBLIC_TARGET_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_TARGET_CHAIN_EXPLORER=https://sepolia.basescan.org
